-- ================================================================
-- Supabase Database Bootstrap — 02-service-passwords.sql  (v3)
-- ================================================================
-- Sets passwords on the LOGIN roles that Supabase services use.
--
-- This file is a TEMPLATE. deploy-stack.sh renders the :'placeholder'
-- variables with real values pulled from Key Vault, then executes it
-- via psql -v flags.
--
-- Login roles that need passwords:
--   supabase_admin          — superuser; rendered with POSTGRES_PASSWORD
--   authenticator           — PostgREST connects as this
--   supabase_auth_admin     — GoTrue connects as this
--   supabase_storage_admin  — Storage API connects as this
--   supabase_realtime_admin — Realtime connects as this (some setups)
--
-- Roles WITHOUT login (anon, authenticated, service_role) need no
-- password — they are switched into, never connected to directly.
-- ================================================================

\set ON_ERROR_STOP on

-- ───────────── force SCRAM-SHA-256 hashing ─────────────
-- The postgres image historically defaulted to md5 password hashing.
-- That worked for unix-socket connections (pg_hba 'trust' line) but
-- FAILED on TCP because we configure pg_hba for SCRAM there. Hashes
-- were stored md5, services tried SCRAM auth, mismatch, login refused.
--
-- SET LOCAL password_encryption inside the same transaction as the
-- ALTER ROLEs ensures all hashes below are stored as SCRAM-SHA-256.
BEGIN;
  SET LOCAL password_encryption = 'scram-sha-256';

  ALTER ROLE supabase_admin           WITH PASSWORD :'postgres_pw';
  ALTER ROLE authenticator            WITH PASSWORD :'authenticator_pw';
  ALTER ROLE supabase_auth_admin      WITH PASSWORD :'auth_admin_pw';
  ALTER ROLE supabase_storage_admin   WITH PASSWORD :'storage_admin_pw';
  ALTER ROLE supabase_realtime_admin  WITH PASSWORD :'realtime_admin_pw';
COMMIT;

-- supabase_auth_admin needs full control of the auth schema so GoTrue
-- can run its own migrations on startup. (Repeated from 01 as belt-
-- and-braces — safe to re-grant.)
GRANT ALL ON SCHEMA auth TO supabase_auth_admin;
ALTER ROLE supabase_auth_admin SET search_path = auth;

-- supabase_storage_admin likewise for the storage schema.
GRANT ALL ON SCHEMA storage TO supabase_storage_admin;
ALTER ROLE supabase_storage_admin SET search_path = storage;

-- supabase_realtime_admin needs realtime + _realtime
GRANT ALL ON SCHEMA realtime  TO supabase_realtime_admin;
GRANT ALL ON SCHEMA _realtime TO supabase_realtime_admin;
ALTER ROLE supabase_realtime_admin SET search_path = _realtime;

DO $$
BEGIN
  RAISE NOTICE '✓ 02-service-passwords.sql complete';
  RAISE NOTICE '  Passwords set (SCRAM-SHA-256): supabase_admin, authenticator,';
  RAISE NOTICE '  supabase_auth_admin, supabase_storage_admin, supabase_realtime_admin';
  RAISE NOTICE '  Next: run 03-realtime-setup.sql';
END
$$;

# ================================================================
# Supabase Stack — Environment Configuration (v3)
# ================================================================
# Copy to ".env" on the VM and fill in the values. Most secrets are
# pulled from Key Vault by scripts/deploy-stack.sh — see README.
#
#   cp .env.template .env   &&   edit .env
#
# NEVER commit the filled-in .env to git.
# ================================================================

# ─── PostgreSQL ───
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin
# Strong password — generated by deploy script or set manually
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD

# Service-role login passwords (set in bootstrap 02-service-passwords.sql)
AUTHENTICATOR_PASSWORD=REPLACE_AUTHENTICATOR_PASSWORD
AUTH_ADMIN_PASSWORD=REPLACE_AUTH_ADMIN_PASSWORD
STORAGE_ADMIN_PASSWORD=REPLACE_STORAGE_ADMIN_PASSWORD

# ─── JWT — the shared signing secret + derived API keys ───
# Pulled from Key Vault: SUPABASE-JWT-SECRET / -ANON-KEY / -SERVICE-KEY
JWT_SECRET=REPLACE_JWT_SECRET
ANON_KEY=REPLACE_ANON_KEY
SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY
JWT_EXPIRY=3600

# ─── API endpoint ───
# The VM's private IP (from terraform output vm_private_ip).
# Used by GoTrue/Studio to build absolute URLs.
SUPABASE_PRIVATE_IP=REPLACE_VM_PRIVATE_IP
API_EXTERNAL_URL=http://REPLACE_VM_PRIVATE_IP:8000
SITE_URL=http://REPLACE_VM_PRIVATE_IP:3000

# ─── Auth (GoTrue) ───
# Email confirmation OFF initially (no SMTP yet — decided earlier).
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_DISABLE_SIGNUP=false
# When SMTP is added later, set these and flip AUTOCONFIRM to false:
# GOTRUE_SMTP_HOST=
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=
# GOTRUE_SMTP_PASS=
# GOTRUE_SMTP_SENDER_NAME=

# ─── Studio dashboard ───
STUDIO_DEFAULT_ORGANIZATION=REPLACE_CUSTOMER_NAME
STUDIO_DEFAULT_PROJECT=self-hosted-supabase
# Basic-auth protecting Studio (Kong enforces it)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=REPLACE_DASHBOARD_PASSWORD

# ─── Storage ───
# 'file' backend — writes to a Docker named volume that lives on the
# managed data disk (Docker data-root = /mnt/supabase-data/docker).
STORAGE_BACKEND=file
STORAGE_FILE_BACKEND_PATH=/var/lib/storage
FILE_SIZE_LIMIT=52428800

# ─── Realtime ───
REALTIME_SECRET_KEY_BASE=REPLACE_REALTIME_SECRET_KEY_BASE

# ─── Data disk paths on the VM (host side) ───
# Used by backup.sh / restore.sh to find pg_dump output, etc.
# Note: compose itself no longer bind-mounts data dirs — it uses named
# volumes. But DATA_DIR is still the disk we snapshot/back up.
DATA_DIR=/mnt/supabase-data

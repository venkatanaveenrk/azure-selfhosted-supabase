# ================================================================
# Outputs
# ================================================================

output "vm_private_ip" {
  description = "Supabase VM private IP — use this in app envVars and over VPN"
  value       = azurerm_network_interface.supabase.private_ip_address
}

output "supabase_api_url" {
  description = "Supabase API endpoint (Kong). Apps use THIS as their SUPABASE_URL."
  value       = "http://${azurerm_network_interface.supabase.private_ip_address}:8000"
}

output "studio_url" {
  description = "Supabase Studio dashboard — reachable over VPN"
  value       = "http://${azurerm_network_interface.supabase.private_ip_address}:3000"
}

output "vnet_id" {
  description = "VNet ID — for App Service VNet integration (configure in the portal per app)"
  value       = azurerm_virtual_network.supabase.id
}

output "appservice_subnet_id" {
  description = "Delegated subnet ID — pick this when enabling VNet integration on an app"
  value       = azurerm_subnet.appservice.id
}

output "appservice_subnet_name" {
  description = "Delegated subnet NAME — what you see in the portal dropdown"
  value       = azurerm_subnet.appservice.name
}

output "vnet_name" {
  description = "VNet name — what you see in the portal dropdown"
  value       = azurerm_virtual_network.supabase.name
}

output "vpn_gateway_status" {
  description = "Whether the VPN Gateway is provisioned"
  value       = var.enable_vpn_gateway ? "ENABLED — download client config from the Azure Portal: ${var.vm_name}-vpn-gw → Point-to-site configuration → Download VPN client" : "DISABLED — set var.enable_vpn_gateway = true to provision"
}

output "vpn_gateway_public_ip" {
  description = "VPN Gateway public IP (only if enabled)"
  value       = var.enable_vpn_gateway ? azurerm_public_ip.vpn[0].ip_address : "n/a"
}

output "key_vault_secrets_to_set" {
  description = "Secrets that must exist in Key Vault BEFORE running terraform apply. Generate all four in one step with scripts/generate-jwt-keys.sh <key-vault-name>."
  value = [
    "SUPABASE-JWT-SECRET     (generated by scripts/generate-jwt-keys.sh)",
    "SUPABASE-DB-PASSWORD    (generated by scripts/generate-jwt-keys.sh)",
    "SUPABASE-ANON-KEY       (generated by scripts/generate-jwt-keys.sh)",
    "SUPABASE-SERVICE-KEY    (generated by scripts/generate-jwt-keys.sh)",
  ]
}

output "next_steps" {
  description = "What to do after terraform apply"
  value = <<-EOT
    1. If you haven't already, run: scripts/generate-jwt-keys.sh <key-vault-name>
       (creates the 4 secrets listed in key_vault_secrets_to_set — do this BEFORE
       terraform apply if you haven't; safe to re-run, it won't overwrite existing secrets)
    2. (If VPN enabled) Configure auth + download VPN client from the portal
    3. Copy compose/, bootstrap/, scripts/ to the VM at /opt/supabase (see DEPLOY.md Step 6)
    4. Run scripts/deploy-stack.sh on the VM (see DEPLOY.md Step 7)
    5. Enable VNet integration on each app needing Supabase (portal: App Service → Networking → VNet integration → ${azurerm_virtual_network.supabase.name} / ${azurerm_subnet.appservice.name})
    6. Add SUPABASE_URL/SUPABASE_ANON_KEY to each app's config (see WIRING-AN-APP-TO-SUPABASE.md)
  EOT
}
